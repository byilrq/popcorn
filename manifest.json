{
  "manifest_version": 3,
  "name": "Popcorn",
  "version": "0.61.0",
  "description": "Popcorn standalone browser extension (v62.0, BTN first-season IMDb field fix)",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Popcorn",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://movie.douban.com/*"
      ],
      "js": [
        "content/popcorn_chd_final_guard.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "short_name": "Popcorn"
}
